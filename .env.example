# ======================================================================
# JMA3A — PUBLIC / ENVIRONMENT EXAMPLE
# Copy to .env.local for local development. NEVER commit real secrets.
# ======================================================================

# App & Branding
NEXT_PUBLIC_APP_NAME=JMA3A
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=darija
APP_ENV=development

# Security Secrets (Generate using openssl rand -base64 32)
SESSION_SECRET=development_session_secret_replace_in_production_32chars
GAME_SECRET_KEY=development_game_secret_key_replace_in_production_32chars

# Database (PostgreSQL / Neon - Optional for local dev fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/jma3a?sslmode=disable

# Realtime / Coordination (Redis / Upstash - Optional for local dev fallback)
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
